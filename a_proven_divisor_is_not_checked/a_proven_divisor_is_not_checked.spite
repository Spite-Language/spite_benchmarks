var clock = Clock()
var console = Console()
var _amount_range = 9973

func AProvenDivisorIsNotChecked() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = fill_and_share()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func fill_and_share(): Long {
    var amounts = List<Integer>()
    var index = 0
    while index < 1000000 {
        amounts.append(index % _amount_range)
        index = index + 1
    }
    return rounds(amounts)
}

func rounds(amounts: List<Integer>): Long {
    var total: Long = 0
    var round = 0
    while round < 20 {
        var parts = round % 7 + 1
        var shared = shares(amounts, parts)
        total = total + shared
        round = round + 1
    }
    return total
}

func shares(amounts: List<Integer>, parts: Integer): Long {
    crash parts > 0
    var total: Long = 0
    var index = 0
    while index < amounts.count() {
        var amount = amounts[index]
        total = total + amount / parts + amount % parts
        index = index + 1
    }
    return total
}
