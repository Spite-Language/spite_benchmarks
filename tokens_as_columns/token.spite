enum TokenKind {
    'identifier'
    'number'
    'symbol'
}

var kind: TokenKind
var start: Integer
var length: Integer
var line: Integer
var value: Long

func Token(made_kind: TokenKind, made_start: Integer, made_length: Integer, made_line: Integer, made_value: Long) {
    kind = made_kind
    start = made_start
    length = made_length
    line = made_line
    value = made_value
}

func checksum(): Long {
    var total: Long = start
    total = total + length * 7 + line * 13
    total = total + value % 1000
    return total
}
