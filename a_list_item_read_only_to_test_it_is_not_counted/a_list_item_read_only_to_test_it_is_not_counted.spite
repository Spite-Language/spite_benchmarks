var clock = Clock()
var console = Console()
var entries = List<Entry>()
var found = 0
var keys = 0
var _entry_count = 200000
var _probe_count = 20000000
var _probe_stride = 7919
var _probe_range = 400000

func AListItemReadOnlyToTestItIsNotCounted() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    fill_and_probe()
    var finished = clock.elapsed()
    console.print("found", found, "keys", keys)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func fill_and_probe() {
    var index = 0
    while index < _entry_count {
        var made = Entry(index % 1000)
        entries.append(made)
        index = index + 1
    }
    found = probe(_probe_count)
    keys = entries.sum_key()
}

func probe(probes: Integer): Integer {
    var found = 0
    var missing = 0
    var at = 0
    var index = 0
    while index < probes {
        at = (at + _probe_stride) % _probe_range
        if entries[at] {
            found = found + 1
        } else {
            missing = missing + 1
        }
        index = index + 1
    }
    crash found + missing == probes
    return found
}
