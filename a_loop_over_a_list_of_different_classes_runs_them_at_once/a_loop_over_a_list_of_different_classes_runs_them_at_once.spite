type Voice {
    render()
}

var clock = Clock()
var console = Console()
var sine = Sine()
var square = Square()
var saw = Saw()
var voices = List<Voice>()

func ALoopOverAListOfDifferentClassesRunsThemAtOnce() {
    load "../../spite_standard_library/windows"
    add_voices()
    var started = clock.elapsed()
    render_all()
    var finished = clock.elapsed()
    console.print(sine.level, square.level, saw.level)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func add_voices() {
    voices.append(sine)
    voices.append(square)
    voices.append(saw)
}

func render_all() {
    voices.each_render()
}
