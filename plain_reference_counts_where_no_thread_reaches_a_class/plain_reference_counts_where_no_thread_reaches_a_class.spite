var console = Console()
var clock = Clock()
var _summing_limit = 20000000
var _point_count = 200000
var _second_coordinate_range = 700

func PlainReferenceCountsWhereNoThreadReachesAClass() {
    load "../../spite_standard_library/windows"
    var start = clock.elapsed()
    var summer = Summer(_summing_limit)
    var sum = summer.total()
    var points = make_points(_point_count)
    var near = count_near(points)
    var finished: Long = sum
    var taken = clock.elapsed() - start
    var microseconds = taken.total('microseconds')
    console.print("sum", finished, "near", near)
    console.error("microseconds {microseconds}")
}

func make_points(count: Integer): List<Point> {
    var points = List<Point>()
    var index = 0
    while index < count {
        var point = Point(index % 1000, index % _second_coordinate_range)
        points.append(point)
        index = index + 1
    }
    return points
}

func count_near(points: List<Point>): Long {
    var near: Long = 0
    var round = 0
    while round < 20 {
        var kept = List<Point>()
        var index = 0
        while index < points.count() {
            var point = points[index]
            if point.across + point.down > round * 80 {
                kept.append(point)
            }
            index = index + 1
        }
        near = near + kept.count()
        round = round + 1
    }
    return near
}
