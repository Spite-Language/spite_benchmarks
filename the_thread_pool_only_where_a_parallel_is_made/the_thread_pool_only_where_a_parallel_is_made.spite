var clock = Clock()
var console = Console()
var _summing_limit = 20000000

func TheThreadPoolOnlyWhereAParallelIsMade() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = sum_all()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func sum_all(): Long {
    return sum_evens_and_odds(_summing_limit)
}

func sum_evens_and_odds(limit: Integer): Long {
    var evens = Summer(limit, 0)
    var even_sum = evens.total()
    var odds = Summer(limit, 1)
    var odd_sum = odds.total()
    return even_sum + odd_sum
}
