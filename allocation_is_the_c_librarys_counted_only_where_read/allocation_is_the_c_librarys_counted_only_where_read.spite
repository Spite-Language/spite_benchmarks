var clock = Clock()
var console = Console()

func AllocationIsTheCLibrarysCountedOnlyWhereRead() {
    load "../../SpiteCompiler/.spite/library/windows"
    var started = clock.elapsed_nanoseconds()
    var answer = every_round()
    var finished = clock.elapsed_nanoseconds()
    console.print("total", answer)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}

func every_round(): Long {
    return all_rounds(2000)
}

func all_rounds(rounds: Integer): Long {
    var total: Long = 0
    var round = 0
    while round < rounds {
        var chain = made_chain(1000, round)
        var sum = chain_sum(chain)
        total = total + sum
        round = round + 1
    }
    return total
}

func made_chain(length: Integer, round: Integer): Node {
    var head = Node(round, null)
    var index = 1
    while index < length {
        var added = Node(index + round, head)
        head = added
        index = index + 1
    }
    return head
}

func chain_sum(head: Node): Integer {
    var total = 0
    var current: Node? = head
    while current {
        total = total + current.value
        current = current.next
    }
    return total
}
