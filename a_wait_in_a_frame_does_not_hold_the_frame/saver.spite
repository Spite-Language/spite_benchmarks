var program = Program()
var next_part = 0
var saved = 0

func save_part() {
    var twenty_milliseconds = Duration(20, 'milliseconds')
    var part = next_part
    next_part = next_part + 1
    program.sleep(twenty_milliseconds)
    var file = File(".spite/frame_save_{part}.txt")
    crash file.write_string("part {part}")
    saved = saved + 1
}
