var console = Console()
var clock = Clock()
var shelf = Shelf()

func ASingletonsAttributeThatNeverChangesIsReadInPlace() {
    load "../../spite_standard_library/windows"
    var start = clock.elapsed()
    fill_shelf(1000000)
    var total = read_shelf()
    var taken = clock.elapsed() - start
    var microseconds = taken.total('microseconds')
    console.print("total", total)
    console.error("microseconds {microseconds}")
}

func fill_shelf(count: Integer) {
    var index = 0
    while index < count {
        var box = Box(index % 100)
        shelf.insert(box)
        index = index + 1
    }
}

func read_shelf(): Long {
    var reader = Reader(4)
    return reader.run()
}
