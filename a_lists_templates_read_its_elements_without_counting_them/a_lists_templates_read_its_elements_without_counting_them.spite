var clock = Clock()
var console = Console()
var total: Long = 0
var numbers = 0
var _body_count = 200000

func AListsTemplatesReadItsElementsWithoutCountingThem() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    fill_and_simulate()
    var finished = clock.elapsed()
    console.print("total", total, "labels", numbers)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func fill_and_simulate() {
    var bodies = List<Body>()
    var labels = List<Label>()
    var index = 0
    while index < _body_count {
        var body = Body(index % 5 + 1)
        bodies.append(body)
        var label = Label(index % 10)
        labels.append(label)
        index = index + 1
    }
    total = simulate(bodies)
    numbers = labels.sum_number()
}

func simulate(bodies: List<Body>): Long {
    var total: Long = 0
    var round = 0
    while round < 100 {
        bodies.each_advance()
        var positions = bodies.sum_position()
        total = total + positions
        round = round + 1
    }
    return total
}
