var clock = Clock()
var console = Console()
var built_length = 0
var joined_length = 0
var _item_count = 3000000

func TextBuilding() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    build_texts()
    var finished = clock.elapsed()
    console.print("built", built_length, "joined", joined_length)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func build_texts() {
    var built = ""
    var index = 0
    while index < _item_count {
        built = "{built}item {index},"
        index = index + 1
    }
    var words = List<String>()
    index = 0
    while index < 1000000 {
        words.append("word{index}")
        index = index + 1
    }
    var joined = words.join(", ")
    built_length = built.length()
    joined_length = joined.length()
}
