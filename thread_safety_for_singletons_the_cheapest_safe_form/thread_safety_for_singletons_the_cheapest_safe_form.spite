var console = Console()
var clock = Clock()
var counter = HitCounter()
var journal = Journal()
var settings = Settings()

func ThreadSafetyForSingletonsTheCheapestSafeForm() {
    load "../../spite_standard_library/windows"
    var start = clock.elapsed()
    journal.note("starting")
    var rounds = count_four_times(1000000)
    journal.note("finished")
    var name = settings.name()
    var total = counter.total()
    var written = journal.written()
    var taken = clock.elapsed() - start
    var microseconds = taken.total('microseconds')
    console.print(name, total, "after", rounds, "rounds, journal lines:", written)
    console.error("microseconds {microseconds}")
}

func count_four_times(rounds: Integer): Integer {
    var first = Worker(rounds)
    var first_run = first.run()
    var second = Worker(rounds)
    var second_run = second.run()
    var third = Worker(rounds)
    var third_run = third.run()
    var fourth = Worker(rounds)
    var fourth_run = fourth.run()
    return first_run + second_run + third_run + fourth_run
}
