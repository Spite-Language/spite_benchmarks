var clock = Clock()
var console = Console()
var _point_count = 200000
var _second_coordinate_range = 700

func AtomicReferenceCountsOnlyWithThreads() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = make_and_count()
    var finished = clock.elapsed()
    console.print("near", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_and_count(): Long {
    var points = make_points(_point_count)
    return count_near(points)
}

func make_points(count: Integer): List<Point> {
    var points = List<Point>()
    var index = 0
    while index < count {
        var point = Point(index % 1000, index % _second_coordinate_range)
        points.append(point)
        index = index + 1
    }
    return points
}

func count_near(points: List<Point>): Long {
    var near: Long = 0
    var round = 0
    while round < 20 {
        var kept = List<Point>()
        var index = 0
        while index < points.count() {
            var point = points[index]
            if point.across + point.down > round * 80 {
                kept.append(point)
            }
            index = index + 1
        }
        near = near + kept.count()
        round = round + 1
    }
    return near
}
