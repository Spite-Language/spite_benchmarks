var clock = Clock()
var console = Console()
var evens = Evens()
var odds = Odds()

func CallsInARowRunAtOnce() {
    var started = clock.elapsed()
    count_both()
    var finished = clock.elapsed()
    console.print(evens.total, odds.total)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func count_both() {
    evens.count()
    odds.count()
}
