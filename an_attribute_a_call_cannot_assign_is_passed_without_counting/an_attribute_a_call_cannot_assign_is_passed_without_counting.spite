var clock = Clock()
var console = Console()
var meter: Meter = null

func AnAttributeACallCannotAssignIsPassedWithoutCounting() {
    load "../../spite_standard_library/windows"
    meter = Meter()
    var started = clock.elapsed()
    var answer = measure_every_reading()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func measure_every_reading(): Integer {
    return meter.measure_all(10000000)
}
