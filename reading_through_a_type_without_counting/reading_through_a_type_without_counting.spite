var clock = Clock()
var console = Console()
var mover = Mover()
var _tick_count = 200

func ReadingThroughATypeWithoutCounting() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = move_all()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func move_all(): Long {
    var positions = List<Position>()
    var velocities = List<Velocity>()
    fill(positions, velocities, 100000)
    ticks(positions, velocities)
    return positions.sum_place()
}

func fill(positions: List<Position>, velocities: List<Velocity>, count: Integer) {
    var index = 0
    while index < count {
        var position = Position()
        positions.append(position)
        var velocity = Velocity(index % 13 - 6, index % 7 - 3)
        velocities.append(velocity)
        index = index + 1
    }
}

func ticks(positions: List<Position>, velocities: List<Velocity>) {
    var tick = 0
    while tick < _tick_count {
        var index = 0
        while index < positions.count() {
            crash velocities[index]
            var moving = {position: positions[index], velocity: velocities[index]}
            mover.advance(moving, tick % 3)
            index = index + 1
        }
        tick = tick + 1
    }
}
