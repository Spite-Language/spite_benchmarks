var clock = Clock()
var console = Console()
var records = Buffer(0)
var _negative_offset = 50000
var _round_count = 300

func ANumberReadFromBytesIsOneLoad() {
    load "../../spite_standard_library/windows"
    fill(100000)
    var started = clock.elapsed()
    var answer = all_rounds()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func fill(count: Integer) {
    var index = 0
    while index < count {
        records.append_integer_big_endian(index)
        records.append_integer_big_endian(index * 7 - _negative_offset)
        records.append_integer_big_endian(index % 1000)
        var kind: Short = index % 5
        records.append_short_big_endian(kind)
        var flags: Short = index % 3
        records.append_short_big_endian(flags)
        index = index + 1
    }
}

func all_rounds(): Long {
    return rounds(records)
}

func rounds(records: Buffer): Long {
    var total: Long = 0
    var round = 0
    while round < _round_count {
        var decoded = decode(records)
        total = total + decoded + round
        round = round + 1
    }
    return total
}

func decode(records: Buffer): Long {
    var total: Long = 0
    var position = 0
    while position + 15 < records.count() {
        var identity = records.read_integer_big_endian_at(position)
        var across = records.read_integer_big_endian_at(position + 4)
        var down = records.read_integer_big_endian_at(position + 8)
        var kind = records.read_short_big_endian_at(position + 12)
        var flags = records.read_short_big_endian_at(position + 14)
        total = total + identity + across + down * kind + flags
        position = position + 16
    }
    return total
}
