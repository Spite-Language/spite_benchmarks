type Measured {
    measure(): Double
}

var clock = Clock()
var console = Console()
var _step_count = 20000000

func AFunctionTakingATypeIsCompiledPerClass() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = every_measure()
    var finished = clock.elapsed()
    var whole: Long = answer
    console.print("total", whole)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func every_measure(): Double {
    return measure_all(_step_count)
}

func measure_all(steps: Integer): Double {
    var total: Double = 0.0
    var count = Count(0)
    var share = Share(0.0)
    var crate = Crate(1.0, 2.0, 3.0)
    var ball = Ball(1.0)
    var step = 0
    while step < steps {
        count.value = step % 10
        total = total + doubled(count)
        share.value = step % 4
        total = total + doubled(share)
        crate.width = step % 7
        total = total + doubled(crate)
        ball.radius = step % 5
        total = total + doubled(ball)
        step = step + 1
    }
    return total
}

func doubled(value: Measured): Double {
    var measure = value.measure()
    return measure + measure
}
