var meter = Meter()
var phase = 0
var _step_count = 20000000
var _half_period = 500

func render() {
    var step = 0
    while step < _step_count {
        phase = (phase + 13) % 1000
        var folded = phase
        if folded > _half_period {
            folded = 1000 - folded
        }
        meter.record(folded * 2)
        step = step + 1
    }
}
