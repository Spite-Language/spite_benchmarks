var clock = Clock()
var console = Console()
var tally = Tally()
var counted = 0
var total: Long = 0
var calls = 0
var largest = 0
var _call_count = 5000000

func ACountedLoopOfCallsToOneSingletonTakesItsLockOnce() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    count_and_read()
    var finished = clock.elapsed()
    console.print("counted", counted, "calls", calls, "total", total, "largest", largest)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func count_and_read() {
    counted = count_four_times(_call_count)
    total = tally.sum()
    calls = tally.call_count()
    largest = tally.largest_amount()
}

func count_four_times(rounds: Integer): Integer {
    var first = Counter(rounds)
    var first_run = first.count_up()
    var second = Counter(rounds)
    var second_run = second.count_up()
    var third = Counter(rounds)
    var third_run = third.count_up()
    var fourth = Counter(rounds)
    var fourth_run = fourth.count_up()
    return first_run + second_run + third_run + fourth_run
}
