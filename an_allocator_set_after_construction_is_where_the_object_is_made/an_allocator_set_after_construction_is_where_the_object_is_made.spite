var clock = Clock()
var console = Console()

func AnAllocatorSetAfterConstructionIsWhereTheObjectIsMade() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = every_round()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func every_round(): Long {
    return all_rounds(200)
}

func all_rounds(rounds: Integer): Long {
    var total: Long = 0
    var round = 0
    while round < rounds {
        var sum = one_round(round)
        total = total + sum
        round = round + 1
    }
    return total
}

func one_round(round: Integer): Integer {
    var particles = List<Particle>()
    var index = 0
    while index < 10000 {
        var particle = Particle(index + round, index % 5)
        particles.append(particle)
        index = index + 1
    }
    return particles.sum_position() + particles.sum_speed()
}
