var letters = List<Letter>()
var kept_total = 0
var _letter_count = 2000
var _round_count = 2000

func Archive() {
    var index = 0
    while index < _letter_count {
        var letter = Letter(index)
        letters.append(letter)
        index = index + 1
    }
}

func sort() {
    var round = 0
    while round < _round_count {
        var kept = List<Letter>()
        var index = 0
        while index < letters.count() {
            var letter = letters[index]
            if letter.words % 3 == round % 3 {
                kept.append(letter)
            }
            index = index + 1
        }
        kept_total = kept_total + kept.count()
        round = round + 1
    }
}
