var clock = Clock()
var console = Console()
var _entity_count = 3000000

func AnArgumentItsCallerHoldsIsPassedWithoutCounting() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = stream_all()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func stream_all(): Integer {
    return stream_entities(_entity_count)
}

func stream_entities(entity_count: Integer): Integer {
    var stream = Stream(entity_count)
    return stream.run()
}
