var clock = Clock()
var console = Console()
var program = Program()
var saver = Saver()
var frames = 0
var checksum: Long = 0
var _steps_per_draw = 20000

func AWaitInAFrameDoesNotHoldTheFrame() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = run_frames()
    var finished = clock.elapsed()
    console.print("frames", frames, "parts saved", answer, "checksum", checksum)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func run_frames(): Integer {
    var one_millisecond = Duration(1, 'milliseconds')
    while frames < 60 {
        frames = frames + 1
        draw()
        if frames <= 8 {
            saver.save_part()
        }
        program.sleep(one_millisecond)
    }
    while saver.saved < 8 {
        program.sleep(one_millisecond)
    }
    return saver.saved
}

func draw() {
    var index = 0
    while index < _steps_per_draw {
        checksum = checksum + index * frames % 1000
        index = index + 1
    }
}
