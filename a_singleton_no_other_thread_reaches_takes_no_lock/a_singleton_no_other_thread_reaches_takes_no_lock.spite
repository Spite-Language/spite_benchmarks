var console = Console()
var clock = Clock()
var ledger = Ledger()

func ASingletonNoOtherThreadReachesTakesNoLock() {
    load "../../spite_standard_library/windows"
    var start = clock.elapsed()
    var counted = count_with_worker()
    var amounts = [4, 12, 30, 7]
    var large = amounts.filter(ledger.is_large)
    var seen = note_many(10000000)
    var total = ledger.sum()
    var notes = ledger.note_count()
    var milestones = ledger.milestone_count()
    var large_count = large.count()
    var taken = clock.elapsed() - start
    var microseconds = taken.total('microseconds')
    console.print(
        "counted",
        counted,
        "large",
        large_count,
        "seen",
        seen,
        "notes",
        notes,
        "milestones",
        milestones,
        "total",
        total,
    )
    console.error("microseconds {microseconds}")
}

func count_with_worker(): Integer {
    var worker = Worker()
    return worker.run()
}

func note_many(count: Integer): Integer {
    var seen = 0
    var index = 0
    while index < count {
        index = ledger.note(index)
        seen = seen + ledger.milestones.count()
    }
    return seen
}
