var clock = Clock()
var console = Console()
var total: Long = 0
var large = 0

func SmallerOnes() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed_nanoseconds()
    count_all()
    var finished = clock.elapsed_nanoseconds()
    console.print("total", total, "large", large)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}

func count_all() {
    var values = List<Integer>()
    var index = 0
    while index < 1000000 {
        values.append(index % 1000)
        index = index + 1
    }
    var tally = Tally()
    var round = 0
    while round < 50 {
        values.each(tally.count_value)
        round = round + 1
    }
    total = tally.total
    large = tally.large
}
