type Measured {
    to_double(): Double
}

var clock = Clock()
var console = Console()

func AFunctionTakingATypeIsCompiledPerClass() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed_nanoseconds()
    var answer = every_measure()
    var finished = clock.elapsed_nanoseconds()
    var whole: Long = answer
    console.print("total", whole)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}

func every_measure(): Double {
    return measure_all(20000000)
}

func measure_all(steps: Integer): Double {
    var total: Double = 0.0
    var crate = Crate(1.0, 2.0, 3.0)
    var ball = Ball(1.0)
    var step = 0
    while step < steps {
        var count = step % 10
        total = total + doubled(count)
        var share: Float = step % 4
        total = total + doubled(share)
        crate.width = step % 7
        total = total + doubled(crate)
        ball.radius = step % 5
        total = total + doubled(ball)
        step = step + 1
    }
    return total
}

func doubled(value: Measured): Double {
    var measure = value.to_double()
    return measure + measure
}
