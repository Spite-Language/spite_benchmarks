var clock = Clock()
var console = Console()
var _item_count = 50000

func DefaultsTheConstructorReplacesAreNeverMade() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = every_round()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func every_round(): Long {
    return all_rounds(10)
}

func all_rounds(rounds: Integer): Long {
    var total: Long = 0
    var round = 0
    while round < rounds {
        var sum = one_round(round)
        total = total + sum
        round = round + 1
    }
    return total
}

func one_round(round: Integer): Integer {
    var items = List<Item>()
    var index = 0
    while index < _item_count {
        var owner = Owner((index + round) % 90)
        var item = Item(index % 1000, owner)
        items.append(item)
        index = index + 1
    }
    var ages = items.map_owners().sum_age()
    return items.sum_price() + ages
}
