var x: Float
var y: Float
var z: Float

func Offset(starting_x: Float, starting_y: Float, starting_z: Float) {
    x = starting_x
    y = starting_y
    z = starting_z
}

func sum(other: Offset): Offset {
    return Offset(x + other.x, y + other.y, z + other.z)
}

func scaled(factor: Float): Offset {
    return Offset(x * factor, y * factor, z * factor)
}
