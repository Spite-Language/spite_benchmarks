var clock = Clock()
var console = Console()

func ANumberJoinedIntoTextIsWrittenInPlace() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = all_lines()
    var finished = clock.elapsed()
    console.print("characters", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func all_lines(): Long {
    var total: Long = 0
    var round = 0
    while round < 20 {
        total = total + lines(100000, round)
        round = round + 1
    }
    return total
}

func lines(count: Integer, round: Integer): Integer {
    var total = 0
    var index = 0
    while index < count {
        var line = "line {index} of {round};"
        total = total + line.length()
        index = index + 1
    }
    return total
}
