var clock = Clock()
var console = Console()
var _round_count = 2000

func AllocationIsTheCLibrarysCountedOnlyWhereRead() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = every_round()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func every_round(): Long {
    return all_rounds(_round_count)
}

func all_rounds(rounds: Integer): Long {
    var total: Long = 0
    var round = 0
    while round < rounds {
        var chain = made_chain(1000, round)
        var sum = chain_sum(chain)
        total = total + sum
        round = round + 1
    }
    return total
}

func made_chain(length: Integer, round: Integer): Node {
    var head = Node(round, null)
    var index = 1
    while index < length {
        var added = Node(index + round, head)
        head = added
        index = index + 1
    }
    return head
}

func chain_sum(head: Node): Integer {
    var total = 0
    var current: Node? = head
    while current {
        total = total + current.value
        current = current.next
    }
    return total
}
