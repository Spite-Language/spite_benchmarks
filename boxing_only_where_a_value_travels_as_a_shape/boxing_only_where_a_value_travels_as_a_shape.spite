type Printable {
    to_string(): String
}

var clock = Clock()
var console = Console()
var _value_count = 90000

func BoxingOnlyWhereAValueTravelsAsAShape() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = make_and_measure()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_and_measure(): Long {
    var values = make_values(_value_count)
    return measure_rounds(values)
}

func make_values(count: Integer): List<Printable> {
    var values = List<Printable>()
    var index = 0
    while index < count {
        add_value(values, index)
        index = index + 1
    }
    return values
}

func add_value(values: List<Printable>, index: Integer) {
    var kind = index % 3
    if kind == 0 {
        values.append(index)
    } else if kind == 1 {
        values.append(index % 2 == 0)
    } else {
        values.append("item {index}")
    }
}

func measure_rounds(values: List<Printable>): Long {
    var total: Long = 0
    var round = 0
    while round < 20 {
        var length = measure(values)
        total = total + length
        round = round + 1
    }
    return total
}

func measure(values: List<Printable>): Integer {
    var total = 0
    var index = 0
    while index < values.count() {
        var value = values[index]
        var text = value.to_string()
        total = total + text.length()
        index = index + 1
    }
    return total
}
