var clock = Clock()
var console = Console()

func SingletonsMadeOnFirstUseNeverCounted() {
    load "../../SpiteCompiler/.spite/library/common"
    load "../../SpiteCompiler/.spite/library/windows"
    var started = clock.elapsed_nanoseconds()
    var answer = fetch_all()
    var finished = clock.elapsed_nanoseconds()
    console.print("fetched", answer)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}

func fetch_all(): Long {
    return fetch_on_two(10000000)
}

func fetch_on_two(rounds: Integer): Long {
    var first = Fetcher(rounds)
    var first_run = Parallel(first.fetch_many)
    var second = Fetcher(rounds)
    var second_run = Parallel(second.fetch_many)
    return first_run + second_run
}
