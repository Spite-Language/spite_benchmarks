var clock = Clock()
var console = Console()
var orbits = List<Orbit>()

func ALoopWhosePassesWriteOnlyTheirOwnItemRunsInBands() {
    load "../../SpiteCompiler/.spite/library/common"
    load "../../SpiteCompiler/.spite/library/windows"
    make_orbits(100000)
    var started = clock.elapsed_nanoseconds()
    advance_ticks()
    var finished = clock.elapsed_nanoseconds()
    var turns = orbits.sum_turns()
    console.print("turns", turns)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}

func make_orbits(count: Integer) {
    var index = 0
    while index < count {
        var orbit = Orbit(index)
        orbits.append(orbit)
        index = index + 1
    }
}

func advance_ticks() {
    var tick = 0
    while tick < 10 {
        orbits.each_advance()
        tick = tick + 1
    }
}
