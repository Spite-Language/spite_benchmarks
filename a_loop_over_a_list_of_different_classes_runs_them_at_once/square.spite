var level: Long = 0
var phase = 0
var _sample_count = 30000000
var _half_period = 500

func render() {
    var sample = 0
    while sample < _sample_count {
        phase = (phase + 11) % 1000
        if phase < _half_period {
            level = level + 3
        } else {
            level = level + 1
        }
        sample = sample + 1
    }
}
