var clock = Clock()
var console = Console()
var particles = List<Particle>()
var _particle_count = 200000
var _tick_count = 200

func AnItemWrittenBackToItsOwnSlotIsNotWritten() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = make_and_move()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_and_move(): Integer {
    var index = 0
    while index < _particle_count {
        var made = Particle(index % 7 + 1)
        particles.append(made)
        index = index + 1
    }
    var tick = 0
    while tick < _tick_count {
        step()
        tick = tick + 1
    }
    return particles.sum_left()
}

func step() {
    var index = 0
    while index < particles.count() {
        var particle = particles[index]
        particle.left = particle.left + particle.speed
        particles[index] = particle
        index = index + 1
    }
}
