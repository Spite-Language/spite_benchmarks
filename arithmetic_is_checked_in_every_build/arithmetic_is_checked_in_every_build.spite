var clock = Clock()
var console = Console()
var _round_count = 400

func ArithmeticIsCheckedInEveryBuild() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = fill_and_check()
    var finished = clock.elapsed()
    console.print("total", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func fill_and_check(): Long {
    var values = List<Integer>()
    var index = 0
    while index < 100000 {
        values.append(index % 1000)
        index = index + 1
    }
    return rounds(values)
}

func rounds(values: List<Integer>): Long {
    var total: Long = 0
    var round = 0
    while round < _round_count {
        var sum = checksum(values, round)
        total = total + sum
        round = round + 1
    }
    return total
}

func checksum(values: List<Integer>, round: Integer): Integer {
    var total = 0
    var index = 0
    while index < values.count() {
        total = total + values[index] * 3 + round
        index = index + 1
    }
    return total
}
