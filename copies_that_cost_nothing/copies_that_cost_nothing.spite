var clock = Clock()
var console = Console()
var origin = Point(0, 0)
var _trial_count = 20000000

func CopiesThatCostNothing() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = every_trial()
    var finished = clock.elapsed()
    console.print("total", answer, "origin", origin.x, origin.y)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func every_trial(): Long {
    origin = Point(3, -4)
    return all_trials(origin, _trial_count)
}

func all_trials(origin: Point, trials: Integer): Long {
    var total: Long = 0
    var trial = 0
    while trial < trials {
        var moved = origin.copy()
        moved.move_by(trial % 7 - 3, trial % 5 - 2)
        total = total + moved.distance_from_origin()
        trial = trial + 1
    }
    return total
}
