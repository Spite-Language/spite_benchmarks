var clock = Clock()
var console = Console()
var base64 = Base64()

func ReadingAnAddressIsOneMachineOperation() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed_nanoseconds()
    var answer = encode_all()
    var finished = clock.elapsed_nanoseconds()
    console.print("total", answer)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}

func encode_all(): Long {
    var bytes = Buffer(0)
    var index = 0
    while index < 100000 {
        var value: Byte = index * 7 % 256
        bytes.append(value)
        index = index + 1
    }
    return encode_rounds(bytes)
}

func encode_rounds(bytes: Buffer): Long {
    var total: Long = 0
    var round = 0
    while round < 100 {
        var changed: Byte = round
        bytes[round] = changed
        var encoded = base64.encode(bytes)
        total = total + encoded.length() + encoded.byte_at(round)
        round = round + 1
    }
    return total
}
