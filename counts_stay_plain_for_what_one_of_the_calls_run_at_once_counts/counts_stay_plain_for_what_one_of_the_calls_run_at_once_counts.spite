type Collection {
    sort()
}

var clock = Clock()
var console = Console()
var library = Library()
var sorter = Sorter()

func CountsStayPlainForWhatOneOfTheCallsRunAtOnceCounts() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed_nanoseconds()
    sorter.sort_all()
    var finished = clock.elapsed_nanoseconds()
    console.print(library.archive.kept_total, library.gallery.hung_total)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}
