var clock = Clock()
var console = Console()
var program = Program()
var saver = Saver()
var frames = 0
var checksum: Long = 0

func AWaitInAFrameDoesNotHoldTheFrame() {
    load "../../SpiteCompiler/.spite/library/common"
    load "../../SpiteCompiler/.spite/library/windows"
    var started = clock.elapsed_nanoseconds()
    var answer = run_frames()
    var finished = clock.elapsed_nanoseconds()
    console.print("frames", frames, "parts saved", answer, "checksum", checksum)
    var microseconds = (finished - started) / 1000
    console.error("microseconds {microseconds}")
}

func run_frames(): Integer {
    while frames < 60 {
        frames = frames + 1
        draw()
        if frames <= 8 {
            saver.save_part()
        }
        program.sleep(1)
    }
    while saver.saved < 8 {
        program.sleep(1)
    }
    return saver.saved
}

func draw() {
    var index = 0
    while index < 20000 {
        checksum = checksum + index * frames % 1000
        index = index + 1
    }
}
