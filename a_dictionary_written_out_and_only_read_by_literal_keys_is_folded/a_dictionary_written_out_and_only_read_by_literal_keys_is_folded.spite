var clock = Clock()
var console = Console()
var _result_count = 200000

func ADictionaryWrittenOutAndOnlyReadByLiteralKeysIsFolded() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = fill_and_total()
    var finished = clock.elapsed()
    console.print("points", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func fill_and_total(): Long {
    var results = List<Result>()
    var index = 0
    while index < _result_count {
        var result = Result(index % 4, index % 7, index % 11)
        results.append(result)
        index = index + 1
    }
    return totals(results)
}

func totals(results: List<Result>): Long {
    var total: Long = 0
    var round = 0
    while round < 40 {
        var index = 0
        while index < results.count() {
            var result = results[index]
            var points = points_for(result)
            total = total + points
            index = index + 1
        }
        round = round + 1
    }
    return total
}

func points_for(result: Result): Integer {
    var points = {"gold": 50, "silver": 20, "bronze": 5}
    crash points["gold"]
    crash points["silver"]
    crash points["bronze"]
    return result.golds * points["gold"] + result.silvers * points["silver"] + result.bronzes * points["bronze"]
}
