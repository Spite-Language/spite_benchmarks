var clock = Clock()
var console = Console()
var characters_read = 0
var removed = false

func ConcurrencyMachineryOnlyWhereItIsUsed() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    write_read_and_remove()
    var finished = clock.elapsed()
    console.print("characters", characters_read, "removed", removed)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func write_read_and_remove() {
    var notes = File(".spite/concurrency_machinery_notes.txt")
    characters_read = write_and_read(notes, 50)
    removed = notes.remove()
}

func write_and_read(notes: File, rounds: Integer): Integer {
    var characters = 0
    var round = 0
    while round < rounds {
        crash notes.write_string("round {round} of the notes")
        var read = notes.read_as_string()
        crash read
        characters = characters + read.length()
        round = round + 1
    }
    return characters
}
