type Track {
    render()
}

var clock = Clock()
var console = Console()
var drum = Drum()
var bass = Bass()
var tracks = List<Track>()

func ObjectsMadeForTheirOwnerAreToldApart() {
    load "../../spite_standard_library/windows"
    add_tracks()
    var started = clock.elapsed()
    render_all()
    var finished = clock.elapsed()
    var drum_loud = drum.meter.loud.count()
    var bass_loud = bass.meter.loud.count()
    console.print(drum.meter.total, drum.meter.peak, drum_loud, bass.meter.total, bass.meter.peak, bass_loud)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func add_tracks() {
    tracks.append(drum)
    tracks.append(bass)
}

func render_all() {
    tracks.each_render()
}
