var clock = Clock()
var console = Console()
var _round_count = 200

func MathsOnConstantsIsWorkedOutWhileCompiling() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    var answer = turn_all()
    var finished = clock.elapsed()
    console.print("across", answer)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func turn_all(): Integer {
    var points = make_points(100000)
    var round = 0
    while round < _round_count {
        points.each(turn)
        round = round + 1
    }
    var total = points.sum_across()
    return total.round()
}

func make_points(count: Integer): List<Point> {
    var points = List<Point>()
    var index = 0
    while index < count {
        var across: Float = index % 100
        var down: Float = index % 37
        var point = Point(across, down)
        points.append(point)
        index = index + 1
    }
    return points
}

func turn(point: Point) {
    var turned_across = point.across * 0.5.cosine() - point.down * 0.5.sine()
    var turned_down = point.across * 0.5.sine() + point.down * 0.5.cosine()
    point.across = turned_across
    point.down = turned_down
}
