var clock = Clock()
var console = Console()
var orders = List<Order>()
var buckets = List<List<Order>>()
var total: Long = 0
var seed: Long = 12345
var _order_count = 400000
var _random_multiplier: Long = 1103515245
var _random_increment: Long = 12345
var _query_count = 400000
var _customer_stride = 7919

func AListHeldOnlyByAnotherListLivesInItsSlot() {
    load "../../spite_standard_library/windows"
    make_orders(_order_count)
    var started = clock.elapsed()
    group_and_ask()
    var finished = clock.elapsed()
    console.print("total", total)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_orders(count: Integer) {
    var index = 0
    while index < count {
        seed = (seed * _random_multiplier + _random_increment) % 2147483648
        var customer: Integer = seed % 65536
        var amount: Integer = seed % 1000
        var order = Order(customer, amount)
        orders.append(order)
        index = index + 1
    }
}

func group_and_ask() {
    var round = 0
    while round < 10 {
        group()
        total = total + ask(round)
        round = round + 1
    }
}

func group() {
    buckets.clear()
    var made = 0
    while made < 65536 {
        var bucket = List<Order>()
        buckets.append(bucket)
        made = made + 1
    }
    var index = 0
    while index < orders.count() {
        var order = orders[index]
        crash buckets[order.customer]
        buckets[order.customer].append(order)
        index = index + 1
    }
}

func ask(round: Integer): Long {
    var asked: Long = 0
    var customer = round
    var query = 0
    while query < _query_count {
        customer = (customer * _customer_stride + 13) % 65536
        var bucket = buckets[customer]
        crash bucket
        var at = 0
        while at < bucket.count() {
            asked = asked + bucket[at].amount
            at = at + 1
        }
        query = query + 1
    }
    return asked
}
