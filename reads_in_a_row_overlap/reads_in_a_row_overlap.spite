var clock = Clock()
var console = Console()
var first_file = File(".spite/reads_in_a_row_first.txt")
var second_file = File(".spite/reads_in_a_row_second.txt")

func ReadsInARowOverlap() {
    load "../../spite_standard_library/windows"
    make_files()
    var started = clock.elapsed()
    var answer = all_reads()
    var finished = clock.elapsed()
    var first_removed = first_file.remove()
    var second_removed = second_file.remove()
    console.print("characters", answer, "removed", first_removed, second_removed)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_files() {
    var first_text = make_text("first", 4000)
    var second_text = make_text("second", 4000)
    first_file.write_string(first_text)
    second_file.write_string(second_text)
}

func all_reads(): Long {
    return read_rounds(first_file, second_file, 40)
}

func make_text(word: String, count: Integer): String {
    var lines = List<String>()
    var index = 0
    while index < count {
        lines.append("{word} line number {index}")
        index = index + 1
    }
    return lines.join("\n")
}

func read_rounds(first_file: File, second_file: File, rounds: Integer): Long {
    var characters: Long = 0
    var round = 0
    while round < rounds {
        var read = read_both(first_file, second_file)
        characters = characters + read
        round = round + 1
    }
    return characters
}

func read_both(first_file: File, second_file: File): Integer {
    var first = first_file.read_as_string()
    var second = second_file.read_as_string()
    crash first
    crash second
    return first.length() + second.length()
}
