type Collection {
    sort()
}

var clock = Clock()
var console = Console()
var library = Library()
var sorter = Sorter()

func CountsStayPlainForWhatOneOfTheCallsRunAtOnceCounts() {
    load "../../spite_standard_library/windows"
    var started = clock.elapsed()
    sorter.sort_all()
    var finished = clock.elapsed()
    console.print(library.archive.kept_total, library.gallery.hung_total)
    var taken = finished - started
    var microseconds = taken.total('microseconds')
    console.error("microseconds {microseconds}")
}
